{
  "name": "vibe-coding-basic-class-app",
  "version": "3.0.0-beta.3",
  "description": "AI·Agent·바이브코딩을 시각적으로 가르치는 JuCoding Electron 강의 스튜디오",
  "author": "ju0o",
  "repository": {
    "type": "git",
    "url": "https://github.com/ju0o/Jucoding.git"
  },
  "homepage": "https://github.com/ju0o/Jucoding",
  "main": "src/main/v4-bootstrap.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "dev": "npm start",
    "build:legacy-tracks": "node scripts/build-track-lessons.js",
    "build:v3": "node scripts/build-v3-content.js && node scripts/build-v3-labs.js",
    "capture:v3-fallbacks": "electron scripts/capture-v3-fallbacks.js",
    "build:tracks": "npm run build:v3",
    "build:slides": "esbuild src/content/sessions/session-03-direction.js --bundle --format=iife --target=chrome120 --minify --outfile=src/content/sessions/session-03-direction.bundle.js",
    "sources:refresh": "node scripts/refresh-official-sources.js",
    "audit:curriculum": "node scripts/audit-v3-curriculum.js",
    "audit:v3:s1": "node scripts/audit-v3-advanced-s1.js",
    "qa:print": "electron scripts/qa-v3-print.js",
    "export:script3": "electron scripts/export-session3-script-pdf.js",
    "export:review3": "electron scripts/export-mobile-review-pdf.js docs/reviews/session-03-mobile-review.html release/3강-모바일-검토자료.pdf",
    "check": "node scripts/check.js",
    "lint": "npm run check",
    "smoke:app": "electron scripts/smoke-electron-app.js",
    "smoke:tracks": "electron scripts/smoke-track-lessons.js",
    "release:verify": "node scripts/verify-release-version.js",
    "release:build": "npm run build:v3 && npm run capture:v3-fallbacks && npm run build:slides && npm run audit:curriculum && npm run check && npm run smoke:tracks && npm run qa:print && npm run dist:portable",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "release:current": "node scripts/prepare-release.js && npm run release:build && node scripts/finalize-release.js",
    "release:v3-beta": "npm run release:current"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "three": "^0.184.0"
  },
  "build": {
    "appId": "kr.blankory.vibecoding.basic",
    "productName": "JuCoding",
    "artifactName": "JuCoding ${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JuCoding"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  }
}
